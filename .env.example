# Banco novo (helpdesk) — gerado por nós
HELPDESK_DB_USER=helpdesk_app
HELPDESK_DB_PASSWORD=troque_esta_senha
HELPDESK_DB_NAME=helpdesk

# Banco legado (telemedicina) — somente leitura
LEGACY_DB_HOST=192.168.0.20
LEGACY_DB_PORT=5432
LEGACY_DB_NAME=telemedicina
LEGACY_DB_USER=helpdesk_readonly
LEGACY_DB_PASSWORD=troque_esta_senha

# Segurança
JWT_SECRET_KEY=gere_uma_chave_aleatoria_longa_aqui
ENVIRONMENT=development

# Aplicação
APP_NAME=Chamados Cematel
APP_BASE_URL=http://localhost:8000

# WhatsApp (WAHA): use uma chave aleatória; não salve a chave no Git.
WAHA_API_KEY=gere_outra_chave_aleatoria_longa_aqui
WAHA_GRUPO_ID=
WAHA_GRUPO_DIRETORIA_ID=\n# Grupo exclusivo de administradores e técnicos para alertas de infraestrutura.\nWAHA_GRUPO_MONITORAMENTO_ID=

# Rastreio: vazio desabilita a integração.
PACOTEVICIO_API_KEY=

